<?xml version="1.0"?>
<!-- Actual CAD J1 subset only. Other five joints/accessories intentionally absent.
     Source geometry: prepared-source-meshes.json; transform: committed unchanged base/3 poses.
     Mass/inertia and +/-5 degree demo range are nominal, not hardware calibration. -->
<robot name="eb300_J1_only_import_smoke">
  <mujoco>
    <compiler discardvisual="false" fusestatic="false" strippath="true"/>
  </mujoco>
  <material name="printed"><color rgba="0.65 0.67 0.70 1"/></material>
  <link name="base_link">
    <visual>
      <origin xyz="0 0.04409807911040864 0.046" rpy="1.5707963267948966 0 0"/>
      <geometry><mesh filename="package://robohand_description/meshes/eb300_cad2/visual/1_update_visual.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="printed"/>
    </visual>
    <collision>
      <origin xyz="0 0.04409807911040864 0.046" rpy="1.5707963267948966 0 0"/>
      <geometry><mesh filename="package://robohand_description/meshes/eb300_cad2/collision/1_update_convex.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0185"/>
      <mass value="1.2"/>
      <inertia ixx="0.0023869" ixy="0" ixz="0" iyy="0.0023869" iyz="0" izz="0.0045"/>
    </inertial>
  </link>
  <joint name="J1" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.037" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.08726646259971647" upper="0.08726646259971647" effort="5" velocity="0.08726646259971647"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>
  <link name="shoulder_link">
    <visual>
      <origin xyz="0.0023779061547132777 0.04403391653551557 0.009000000000000142" rpy="1.5707963267948966 0 -0.053949165615788885"/>
      <geometry><mesh filename="package://robohand_description/meshes/eb300_cad2/visual/3_update_visual.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="printed"/>
    </visual>
    <collision>
      <origin xyz="0.0023779061547132777 0.04403391653551557 0.009000000000000142" rpy="1.5707963267948966 0 -0.053949165615788885"/>
      <geometry><mesh filename="package://robohand_description/meshes/eb300_cad2/collision/3_update_convex.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.004992721151706989 0.00026959000442575154 0.058"/>
      <mass value="1.2"/>
      <inertia ixx="0.00241" ixy="0" ixz="0" iyy="0.00288" iyz="0" izz="0.00241"/>
    </inertial>
  </link>
</robot>
